# Copy this file to `secrets.yaml` and fill in your own values.
# `secrets.yaml` is gitignored so your credentials never get committed.

# --- WiFi (your home network) ---
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# --- Fallback AP (hotspot ESPHome brings up if WiFi fails) ---
ap_password: "fallback-ap-password"

# --- Home Assistant API encryption key ---
# Generate a fresh 32-byte base64 key, e.g. with:
#   openssl rand -base64 32
# or via the ESPHome dashboard "Encryption key" helper.
api_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# --- OTA update password ---
ota_password: "your-ota-password"
